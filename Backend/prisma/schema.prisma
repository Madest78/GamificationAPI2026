// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  personalEmail String?  // Gmail or other personal email from Emplanner
  name      String?
  avatarUrl String?
  googleId  String?  @unique
  emplannerUid String? @unique  // Emplanner internal ID (e.g. "631c58d75d8e0655c04c7cf2")
  extraId  String?  @unique     // Contract number from Emplanner extraId (e.g. "23-0003288")
  slackId  String?  @unique
  
  // Emplanner metadata
  emplannerAvailability String?   // ONLINE, OFFLINE, PAUSE
  emplannerRoles Json?            // ["DRAFTER", "SUPERVISOR", ...]
  emplannerTags Json?             // ["T9", "MANAGER", ...]
  emplannerCountry String?        // "Georgia"
  emplannerCity String?           // "Batumi"
  emplannerGender String?         // "MALE", "FEMALE"
  emplannerFired Boolean? @default(false)
  emplannerTimeTracking String?   // START, STOP, PAUSE
  emplannerUtc Int?               // UTC offset in minutes
  emplannerTeams Json?            // memberTeams + leaderTeams
  emplannerProductivity Json?     // calculatedProductivityAverage
  emplannerFeedbackUrl String?
  emplannerHasOnlyTestLicenses Boolean?
  emplannerIsVcs Boolean?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles           UserRole[]
  specializations UserSpecialization[]
  refreshTokens   RefreshToken[]
  revokedTokens   RevokedToken[]
  loginCodes      LoginCode[]
  achievements    UserAchievement[]
  sentKudos       KudosTransaction[] @relation("SentKudos")
  receivedKudos   KudosTransaction[] @relation("ReceivedKudos")
  kudosBalance    UserKudosBalance?
  following       Follow[] @relation("Following")
  followers       Follow[] @relation("Followers")
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Specialization {
  id    String               @id @default(cuid())
  code  String               @unique
  name  String
  users UserSpecialization[]
}

model UserSpecialization {
  userId           String
  specializationId String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([userId, specializationId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?
}

model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  revokedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model LoginCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AchievementDef {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  icon        String?
  condition   Json     // JSONLogic conditions
  points      Int      @default(0)
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserAchievement[]
}

model UserAchievement {
  id              String   @id @default(cuid())
  userId          String
  achievementDefId String
  earnedAt        DateTime @default(now())
  progress        Int      @default(0)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementDef AchievementDef @relation(fields: [achievementDefId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementDefId])
}

model KudosType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  emoji       String
  description String?
  createdAt   DateTime @default(now())

  transactions KudosTransaction[]
}

model KudosTransaction {
  id           String   @id @default(cuid())
  senderId     String
  receiverId   String
  kudosTypeId  String
  message      String?
  createdAt    DateTime @default(now())

  sender     User        @relation("SentKudos", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User        @relation("ReceivedKudos", fields: [receiverId], references: [id], onDelete: Cascade)
  kudosType  KudosType   @relation(fields: [kudosTypeId], references: [id], onDelete: Cascade)
}

model UserKudosBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  lastReset DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}
