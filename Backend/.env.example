# Database
# Локально: postgresql://user:password@localhost:5432/dspeople
# Render.com: берётся из Internal Database URL в Dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/dspeople"

# Server
PORT=3000
NODE_ENV=development

# JWT
# Генерируется автоматически в render.yaml (generateValue: true)
# Локально: создать свой секрет минимум 32 символа
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long"

# Google OAuth
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Render.com: https://dspeople-backend.onrender.com/api/auth/google/callback
# Локально: http://localhost:3000/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Frontend
# Render.com: URL фронтенда (если есть)
# Локально: http://localhost:3001
FRONTEND_URL="http://localhost:3001"

# Allowed email domains for registration
ALLOWED_DOMAINS="dspeople.ru,yourdomain.com"

# Logging
LOG_LEVEL=info
