{"nodes": [{"id": "backend__agents_skills_prisma_mongodb_upgrade_references_client_api_mapping", "label": "client-api-mapping", "file_type": "document", "rationale": "Names map, parity does not: v6 raw methods do not exist under old names, aggregation moved lanes, assuming parity breaks compilation or loses atomicity silently.", "source_file": "Backend/.agents/skills/prisma-mongodb-upgrade/references/client-api-mapping.md", "source_location": null, "source_url": null, "captured_at": null, "author": "prisma", "contributor": null}, {"id": "backend__agents_skills_prisma_mongodb_upgrade_references_client_api_mapping_mongo_raw_lane", "label": "mongoRaw(...) Raw Lane", "file_type": "concept", "rationale": "Replaces v6 $runCommandRaw/findRaw/aggregateRaw which have no Next-side names; arbitrary database commands go through the underlying mongodb driver.", "source_file": "Backend/.agents/skills/prisma-mongodb-upgrade/references/client-api-mapping.md", "source_location": null, "source_url": null, "captured_at": null, "author": "prisma", "contributor": null}, {"id": "backend__agents_skills_prisma_mongodb_upgrade_references_client_api_mapping_typed_aggregation_pipeline_builder", "label": "Typed Aggregation Pipeline Builder (db.query)", "file_type": "concept", "source_file": "Backend/.agents/skills/prisma-mongodb-upgrade/references/client-api-mapping.md", "source_location": null, "source_url": null, "captured_at": null, "author": "prisma", "contributor": null}, {"id": "backend__agents_skills_prisma_mongodb_upgrade_references_client_api_mapping_driver_session_transactions", "label": "MongoDB Driver Session Transactions", "file_type": "concept", "rationale": "Multi-document atomicity works today via client.startSession()/session.withTransaction(...) on a replica set since mongodb is a user-supplied peer dependency.", "source_file": "Backend/.agents/skills/prisma-mongodb-upgrade/references/client-api-mapping.md", "source_location": null, "source_url": null, "captured_at": null, "a