{"nodes": [{"id": "backend__agents_skills_prisma_upgrade_v7_skill_prisma_upgrade_v7", "label": "Prisma ORM v7 Upgrade Guide", "file_type": "document", "source_file": "Backend/.agents/skills/prisma-upgrade-v7/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "prisma", "contributor": null}, {"id": "backend__agents_skills_prisma_upgrade_v7_skill_prisma_client_generator", "label": "prisma-client Generator", "file_type": "rationale", "source_file": "Backend/.agents/skills/prisma-upgrade-v7/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "prisma", "contributor": null, "rationale": "Default generator in v7; prisma-client-js remains only for legacy setups; enables explicit output paths, multiple entrypoints, and TS-native generated code."}, {"id": "backend__agents_skills_prisma_upgrade_v7_skill_driver_adapters", "label": "Driver Adapters", "file_type": "rationale", "source_file": "Backend/.agents/skills/prisma-upgrade-v7/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "prisma", "contributor": null, "rationale": "No native engine binary, smaller bundle size, better serverless/edge compatibility, native Node.js drivers, more control over connection pooling; required for SQL providers in v7."}, {"id": "backend__agents_skills_prisma_upgrade_v7_skill_prisma_config_ts", "label": "prisma.config.ts", "file_type": "rationale", "source_file": "Backend/.agents/skills/prisma-upgrade-v7/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "prisma", "contributor": null, "rationale": "Central CLI configuration file replacing .env+schema-based config; holds schema path, migrations path/seed, and datasource URLs."}, {"id": "backend__agents_skills_prisma_upgrade_v7_skill_explicit_environment_loading", "label": "Explicit Environment Loading", "file_type": "rationale", "source_file": "Backend/.agents/skills/prisma-upgrade-v7/SKILL.md", "source_loc